				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Ramesh Patel\",\n  \"phone\": \"9812345678\",\n  \"email\": \"ramesh@soilart.in\",\n  \"division\": \"Pottery & Clay Shaping\",\n  \"role\": \"Senior Clay Potter\",\n  \"salary\": 35000,\n  \"joinDate\": \"2023-04-10\",\n  \"status\": \"Active\"\n}"
				},
				"url": "http://localhost:5000/api/employees"
			}
		},
		{
			"name": "Update Employee",
			"request": {
				"method": "PUT",
