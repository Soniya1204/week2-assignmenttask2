					"mode": "raw",
					"raw": "{\n  \"name\": \"Ramesh Patel\",\n  \"phone\": \"9812345678\",\n  \"email\": \"ramesh@soilart.in\",\n  \"division\": \"Pottery & Clay Shaping\",\n  \"role\": \"Lead Clay Potter\",\n  \"salary\": 40000,\n  \"joinDate\": \"2023-04-10\",\n  \"status\": \"Active\"\n}"
